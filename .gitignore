# Cargo build output (workspace target dir)
/target/
/dist/

# rustfmt backups
**/*.rs.bk

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Node tooling for graft
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment and secrets
.env
.env.*
!.env.example
.aws/
*.pem
*.key

# Local AI-agent/editor state (AGENTS.md is project documentation and stays tracked)
.agents/
.codex/
.claude/settings.local.json
.cursor/

# Coverage and profiling
tarpaulin-report.html
lcov.info
*.profraw
*.profdata

# Editor and OS junk
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python script bytecode
__pycache__/
*.py[cod]
